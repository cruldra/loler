{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "运行客户端api",
            "type": "shell",
            "command": "uv run uvicorn app:app --host 0.0.0.0 --reload",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "TYPE": "client",
                    "PYTHONPATH": "${workspaceFolder}"
                }
            }
        }
    ]
}
